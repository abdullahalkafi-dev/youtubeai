# ---- Shared infrastructure (same values as the main backend; read-only use of its collections) ----
MONGODB_URI=mongodb://mongodb:27017/youtube_ai?replicaSet=rs0
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Must equal the main backend's JWT_SECRET so the same login works here.
JWT_SECRET=
# Optional dedicated key for encrypting the stored YouTube session (defaults to a key derived from JWT_SECRET).
REEL_SECRET_KEY=

# ---- OpenAI (reel-only model settings; the rest of the app is unaffected) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_REEL_MODEL=gpt-6.1-sol
OPENAI_REEL_FAST_MODEL=gpt-6-luna
OPENAI_REEL_REASONING_EFFORT=high
OPENAI_STT_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Service ----
PORT=5002
# Kill switch: false = API refuses new campaigns and the worker processes nothing.
REELS_ENABLED=true

# ---- Capacity (defaults sized for a 4 vCPU / 16 GB box; worker container is capped at 2.5 CPU / 3 GB) ----
REEL_RENDER_CONCURRENCY=1
REEL_FFMPEG_THREADS=2
REEL_DOWNLOAD_CONCURRENCY=2
REEL_ANALYZE_CONCURRENCY=2
REEL_CAMPAIGN_CONCURRENCY=2
REEL_MAX_REELS_PER_CAMPAIGN=10
REEL_MAX_SOURCES_PER_CAMPAIGN=10
REEL_TOKEN_BUDGET=3000000
REEL_RANGE_COOLDOWN_DAYS=120
REEL_MIN_FREE_DISK_GB=10
REEL_DOWNLOAD_DAILY_CAP=40
REEL_SOURCE_CACHE_GB=40

# ---- Publishing (manual; YouTube first) ----
# The SAME Google OAuth client the main app signs in with. The reel service reuses the main app's Google login
# (read-only) to upload, so no extra consent or scope is needed (youtube.force-ssl allows videos.insert).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Our own conservative per-day upload cap (Google's own limit is 100/day in a separate bucket).
PUBLISH_YT_DAILY_CAP=10
# unlisted | private | public — what the publish dialog preselects.
PUBLISH_DEFAULT_PRIVACY=unlisted
PUBLISH_CONCURRENCY=1
PUBLISH_CHUNK_MB=8
# How long a published post keeps being measured.
METRICS_MAX_AGE_DAYS=90
