# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI="mongodb://localhost:27019/youtube_ai"

# ChromaDB
CHROMADB_URL="http://localhost:8000"

# Redis
REDIS_URL="redis://localhost:6399"

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRY=7d

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_TRENDS_MODEL=gpt-5.6-terra
OPENAI_SEO_MANUAL_MODEL=gpt-5.6-terra
OPENAI_SEO_BATCH_MODEL=gpt-5.6-luna

# Image Generation (Thumbnail / Edit / Scene pipeline)
# Chain: OPENAI_IMAGE_MODEL (first) -> gpt-image-2 (fallback) -> error
# Quality is PER MODEL: sunburst/xhigh, gpt-image-2/medium (xhigh is a 400 on 2.x)
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=xhigh
OPENAI_IMAGE_FALLBACK_QUALITY=medium

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9005
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=thumbnails
MINIO_USE_SSL=false

# Limits
MAX_USERS=2
MAX_CHANNELS_PER_USER=1
BCRYPT_ROUNDS=10
