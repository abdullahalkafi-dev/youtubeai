# Production Server Configuration
PORT=5001
NODE_ENV=production

# MongoDB (Docker container name)
MONGODB_URI="mongodb://mongodb:27017/youtube_ai"

# ChromaDB (Docker container name)
CHROMADB_URL="http://chromadb:8000"

# Redis (Docker container name)
REDIS_URL="redis://redis:6379"

# Ollama (Docker container name)
OLLAMA_URL="http://ollama:11434"

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://YOUR_DOMAIN_OR_IP:5001/api/auth/google/callback

# JWT
JWT_SECRET=your-production-jwt-secret
JWT_EXPIRY=7d

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_TRENDS_MODEL=gpt-5.6-terra

# Frontend URL for CORS
FRONTEND_URL=http://YOUR_DOMAIN_OR_IP:3000

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=thumbnails
MINIO_USE_SSL=false

# Limits
MAX_USERS=2
MAX_CHANNELS_PER_USER=1
BCRYPT_ROUNDS=10
